<Window x:Class="XIVBot.Macro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:XIVBot"
        mc:Ignorable="d"
        Title="Macro" Height="300" Width="200"
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterOwner"
        Loaded="Macro_OnLoaded"
        ResizeMode="NoResize">
    <StackPanel>
        <TextBlock Name="MacroBox" IsEnabled="True"/>
        <Button Style="{StaticResource RoundedButton}" Margin="5px" Content="Copy" Click="ButtonBase_OnClick" />
    </StackPanel>
</Window>
