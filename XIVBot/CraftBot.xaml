<Window x:Class="XIVBot.CraftBot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:XIVBot.ViewModels"
        mc:Ignorable="d"
        Title="Crafting Bot" Height="300" Width="220"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <vm:CraftBotViewModel/>
    </Window.DataContext>
    <StackPanel
        Margin="0,5">
        <Grid Column="2"
              Margin="5px">
            <Label
                HorizontalAlignment="Left"
                Content="Macro Hotkey:"/>
            <TextBox
                HorizontalAlignment="Right"
                Width="100"
                Name="CraftMacro"
                LostFocus="TextboxLoseFocus" VerticalAlignment="Center"
                Text="{Binding Macro, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                HorizontalContentAlignment="Center"
                MaxLength="1"
                TextChanged="CraftMacro_TextChanged"/>
        </Grid>
        <Grid
            Margin="5px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0" HorizontalAlignment="Left" Width="110" Content="Run Time (s):"/>
            <TextBox
                Grid.Column="1"
                Width="50"
                Name="DurationBox"
                PreviewTextInput="ValidateNumberInput"
                HorizontalAlignment="Left"
                LostFocus="TextboxLoseFocus" 
                Height="18" 
                VerticalAlignment="Center"
                Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="TextBoxValueChanged"/>
            <Button
                Grid.Column="1"
                Width="25" Margin="50,0,0,0"
                HorizontalAlignment="Left"
                Command="{Binding DurationUp}" VerticalAlignment="Center"
                Content="^"/>
            <Button
                Grid.Column="3"
                Width="25"
                Command="{Binding DurationDown}" VerticalAlignment="Center"
                Content="v"/>
        </Grid>
        <Grid
            Margin="5px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0" HorizontalAlignment="Left" Width="110" VerticalAlignment="Center"
                Content="Craft Amount:"/>
            <TextBox
                Grid.Column="1"
                Width="50"
                Name="AmountBox"
                PreviewTextInput="ValidateNumberInput"
                HorizontalAlignment="Left"
                LostFocus="TextboxLoseFocus" VerticalAlignment="Center" Height="18"
                Text="{Binding Crafts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="TextBoxValueChanged"/>
            <Button
                Grid.Column="1"
                Width="25" Margin="50,0,0,0" HorizontalAlignment="Left"
                Command="{Binding CraftsUp}" VerticalAlignment="Center"
                Content="^"/>
            <Button
                Grid.Column="3"
                Width="25"
                Name="CraftAmtDownButton"
                Command="{Binding CraftsDown}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Content="v"/>
        </Grid>
        <Grid Column="2"
              Margin="5px">
            <Label Content="Craft Time:"/>
            <Label
                HorizontalAlignment="Right"
                Padding="0,5,35,0"
                Name="LabelTotalTime"
                Content="{Binding Timer, Mode=TwoWay}"/>
        </Grid>
        <Button
            Style="{DynamicResource RoundedButton}"
            Padding="15px"
            Command="{Binding CraftButton}"
            Name="Craft"
            Content="{Binding Button, Mode=TwoWay}"/>
    </StackPanel>
</Window>
