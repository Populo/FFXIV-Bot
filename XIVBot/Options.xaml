<Window x:Class="XIVBot.Options"
        x:Name="OptionsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:XIVBot.ViewModels"
        mc:Ignorable="d"
        Title="Options" Height="350" Width="200"
        SizeToContent="WidthAndHeight" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <vm:OptionsViewModel/>
    </Window.DataContext>
    <StackPanel
        Margin="2px">
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Forward:" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding Forward, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Backward" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding Backward, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"  Content="Turn Left" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding LeftTurn, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Turn Right" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding RightTurn, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Move Left" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding MoveLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Move Right" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding MoveRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Jump" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding Jump, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Gather" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding Gather, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid
            Margin="2px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Craft" HorizontalAlignment="Left"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding Craft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     HorizontalAlignment="Right"
                     Width="100" MaxLength="1"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
        </Grid>
            <Button Content="Save"
                    Command="{Binding SaveButton}"
                    CommandParameter="{Binding ElementName=OptionsForm}"
                    Style="{DynamicResource RoundedButton}"
                    Margin="5px" 
                    Padding="2px"/>
            <Button Content="{Binding UpdateButtonText}"
                    Command="{Binding UpdateButton}"
                    CommandParameter="{Binding ElementName=OptionsForm}"
                    Style="{DynamicResource RoundedButton}"
                    Margin="5px" 
                    Padding="2px"/>
    </StackPanel>
</Window>
